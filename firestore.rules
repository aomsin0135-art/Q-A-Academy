rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global safety net - Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users Collection rules
    match /users/{userId} {
      // Leaderboard requires listing and reading user profiles globally
      allow read: if true;

      // Allow users to create and update their own document
      allow create: if isOwner(userId) 
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid;

      allow update: if isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == existing().createdAt; // createdAt is immutable
    }

    // History Collection rules
    match /history/{historyId} {
      // Allow reading list of history belonging to the authenticated user
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Allow users to log history records that belong to them
      allow create: if isSignedIn()
        && isValidHistory(incoming())
        && incoming().uid == request.auth.uid;

      // History logs are immutable and shouldn't be updated or deleted by clients
      allow update, delete: if false;
    }

    // Validation functions
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 150
        && data.displayName is string && data.displayName.size() <= 150
        && data.totalScore is int && data.totalScore >= 0
        && data.streakCount is int && data.streakCount >= 0
        && data.createdAt is string;
    }

    // Validation for history items
    function isValidHistory(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.subjectId is string && data.subjectId.size() <= 100
        && data.subjectName is string && data.subjectName.size() <= 150
        && data.score is int && data.score >= 0
        && data.totalQuestions is int && data.totalQuestions >= 0
        && data.timestamp is string;
    }
  }
}
